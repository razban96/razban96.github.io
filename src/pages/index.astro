---
const profile = {
    name: "Răzvan Chiurtu",
    role: "Software Developer",
    bio: "Building clean, reliable software—from systems programming in C++ to cloud-native web apps and automation workflows.",
    email: "razvan14chiurtu@gmail.com",
    github: "https://github.com/razban96",
    linkedin: "https://www.linkedin.com/in/razvan-chiurtu/",
};

const projects = [
    {
        title: "BCE Songs Telegram Bot",
        description: "Serverless Telegram bot built with TypeScript and Hono running on Cloudflare Workers.",
        tags: ["TypeScript", "Cloudflare Workers", "Hono"],
        url: "https://github.com/razban96",
    },
    {
        title: "n8n Automation Workflows",
        description: "Modular automation pipelines integrating external APIs and webhook triggers.",
        tags: ["n8n", "JSON", "REST APIs"],
        url: "https://github.com/razban96",
    },
    {
        title: "Core C++ Projects",
        description: "Algorithms, data structures, and systems-level utilities written in modern C++.",
        tags: ["C++", "Algorithms", "CMake"],
        url: "https://github.com/razban96",
    },
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{profile.name} — {profile.role}</title>
    <meta name="description" content={profile.bio}/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
    />
</head>
<body>
<main class="container">
    <!-- Hero / About Section -->
    <header class="hero card">
        <div class="status-badge">
            <span class="dot"></span> Open to opportunities & collaborations
        </div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="bio">{profile.bio}</p>

        <!-- Primary Social & Contact Links -->
        <div class="actions">
            <a
                    href={profile.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
            >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                </svg>
                LinkedIn
            </a>

            <a
                    href={profile.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-secondary"
            >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/>
                </svg>
                GitHub
            </a>

            <a href={`mailto:${profile.email}`} class="btn btn-secondary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
                {profile.email}
            </a>
        </div>
    </header>

    <!-- Featured Projects Section -->
    <section class="projects-section">
        <h2>Selected Projects</h2>
        <div class="projects-grid">
            {
                projects.map((project) => (
                        <a
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="card project-card"
                        >
                            <div class="project-header">
                                <h3>{project.title}</h3>
                                <span class="arrow" aria-hidden="true">↗</span>
                            </div>
                            <p>{project.description}</p>
                            <div class="tags">
                                {project.tags.map((tag) => (
                                        <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </a>
                ))
            }
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© {new Date().getFullYear()} {profile.name} · Built with Astro</p>
    </footer>
</main>

<style>
    :root {
        /* Warm, eye-friendly neutral palette */
        --bg-page: #f5f4f0;
        --bg-card: #ffffff;
        --bg-tag: #f0eee9;
        --text-primary: #1c1917;
        --text-secondary: #57534e;
        --text-muted: #78716c;
        --border-subtle: #e7e5e0;
        --border-hover: #c7c3ba;
        --accent: #292524;
        --accent-hover: #0c0a09;
        --shadow-sm: 0 2px 8px rgba(28, 25, 23, 0.04);
        --shadow-hover: 0 10px 24px rgba(28, 25, 23, 0.08);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--bg-page);
        color: var(--text-primary);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        padding: 3rem 1.25rem;
    }

    .container {
        max-width: 760px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 2.25rem;
    }

    .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
    }

    /* Hero Card */
    .hero {
        padding: 2.5rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.825rem;
        font-weight: 500;
        color: var(--text-secondary);
        background-color: var(--bg-tag);
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        margin-bottom: 1.25rem;
    }

    .dot {
        width: 8px;
        height: 8px;
        background-color: #16a34a;
        border-radius: 50%;
    }

    h1 {
        font-size: 2.1rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.2;
    }

    .role {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--text-secondary);
        margin-top: 0.35rem;
    }

    .bio {
        margin-top: 1.15rem;
        font-size: 1rem;
        color: var(--text-secondary);
        max-width: 60ch;
    }

    /* Buttons & Hover Animations */
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.75rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.15rem;
        border-radius: 10px;
        font-size: 0.925rem;
        font-weight: 500;
        text-decoration: none;
        transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.2s ease,
        background-color 0.2s ease,
        border-color 0.2s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(28, 25, 23, 0.08);
    }

    .btn:active {
        transform: translateY(0);
    }

    .btn-primary {
        background-color: var(--accent);
        color: #ffffff;
        border: 1px solid var(--accent);
    }

    .btn-primary:hover {
        background-color: var(--accent-hover);
    }

    .btn-secondary {
        background-color: var(--bg-card);
        color: var(--text-primary);
        border: 1px solid var(--border-subtle);
    }

    .btn-secondary:hover {
        background-color: var(--bg-page);
        border-color: var(--border-hover);
    }

    /* Projects Grid */
    .projects-section h2 {
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 1rem;
        padding-left: 0.25rem;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .project-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.22s ease,
        border-color 0.22s ease;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
        border-color: var(--border-hover);
    }

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .project-card h3 {
        font-size: 1.02rem;
        font-weight: 600;
    }

    .arrow {
        color: var(--text-muted);
        font-size: 1.1rem;
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .project-card:hover .arrow {
        transform: translate(2px, -2px);
        color: var(--text-primary);
    }

    .project-card p {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 1.25rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .tag {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-secondary);
        background-color: var(--bg-tag);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
    }

    footer {
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-muted);
        padding-top: 0.5rem;
    }

    @media (max-width: 600px) {
        body {
            padding: 1.5rem 1rem;
        }

        .hero {
            padding: 1.75rem;
        }

        h1 {
            font-size: 1.75rem;
        }

        .actions {
            flex-direction: column;
        }

        .btn {
            justify-content: center;
        }
    }
</style>
</body>
</html>