---
const profile = {
    name: "Răzvan Chiurtu",
    role: "Software Developer",
    avatarUrl: "/profile-picture.jpg",
    email: "razvan14chiurtu@gmail.com",
};

// Follow the format to add more cards later
const links = [
    {
        title: "LinkedIn",
        subtitle: "Connect & view experience",
        url: "https://www.linkedin.com/in/razvan-chiurtu/",
        icon: "linkedin",
    },
    {
        title: "GitHub",
        subtitle: "@razban96 · Code & repositories",
        url: "https://github.com/razban96",
        icon: "github",
    },
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} — {profile.role}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
    />
</head>
<body>
<main class="container">
    <!-- Circular Profile Photo + Name -->
    <header class="profile-header">
        <div class="avatar-ring">
            <img
                    src={profile.avatarUrl}
                    alt={profile.name}
                    class="avatar"
                    onerror="this.src='https://github.com/razban96.png'"
            />
        </div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
    </header>

    <!-- Vertical Stack of Link Cards -->
    <section class="links-stack" aria-label="Links">
        {
            links.map((link) => (
                    <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="card link-card"
                    >
                        <div class="card-left">
                            <div class="icon-box" aria-hidden="true">
                                {link.icon === "linkedin" && (
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                                        </svg>
                                )}
                                {link.icon === "github" && (
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z" />
                                        </svg>
                                )}
                            </div>
                            <div class="card-text">
                                <span class="card-title">{link.title}</span>
                                <span class="card-subtitle">{link.subtitle}</span>
                            </div>
                        </div>
                        <span class="arrow" aria-hidden="true">↗</span>
                    </a>
            ))
        }
    </section>

    <!-- Footer with matching Email Card Button -->
    <footer>
        <a href={`mailto:${profile.email}`} class="card link-card email-card">
            <div class="card-left">
                <div class="icon-box" aria-hidden="true">
                    <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    >
                        <rect width="20" height="16" x="2" y="4" rx="2" />
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                </div>
                <div class="card-text">
                    <span class="card-title">Email Me</span>
                    <span class="card-subtitle">{profile.email}</span>
                </div>
            </div>
            <span class="arrow" aria-hidden="true">↗</span>
        </a>

        <p class="copyright">© {new Date().getFullYear()} {profile.name}</p>
    </footer>
</main>

<style>
    :root {
        --bg-page: #1829b4;
        --bg-card: #721ac5;
        --bg-card-hover: #8123db;
        --text-primary: #ffffff;
        --text-secondary: rgba(255, 255, 255, 0.85);
        --border-subtle: rgba(255, 255, 255, 0.16);
        --border-hover: rgba(255, 255, 255, 0.45);
        --shadow-card: 0 6px 18px rgba(10, 17, 77, 0.35);
        --shadow-hover: 0 14px 28px rgba(10, 17, 77, 0.5);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--bg-page);
        color: var(--text-primary);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 3rem 1.25rem;
        -webkit-font-smoothing: antialiased;
    }

    .container {
        width: 100%;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    /* Profile Header & Circular Photo Frame */
    .profile-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .avatar-ring {
        width: 124px;
        height: 124px;
        border-radius: 50%;
        border: 4px solid #721ac5;
        padding: 3px;
        background-color: var(--bg-page);
        box-shadow: 0 8px 24px rgba(10, 17, 77, 0.4);
        margin-bottom: 1rem;
        transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .avatar-ring:hover {
        transform: scale(1.04);
    }

    .avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }

    h1 {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .role {
        font-size: 0.98rem;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }

    /* Vertical Card Stack */
    .links-stack {
        display: flex;
        flex-direction: column;
        gap: 0.95rem;
    }

    .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        box-shadow: var(--shadow-card);
    }

    .link-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.35rem;
        text-decoration: none;
        color: var(--text-primary);
        transition:
                transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
                background-color 0.22s ease,
                box-shadow 0.22s ease,
                border-color 0.22s ease;
    }

    .link-card:hover {
        transform: translateY(-3px) scale(1.01);
        background-color: var(--bg-card-hover);
        box-shadow: var(--shadow-hover);
        border-color: var(--border-hover);
    }

    .link-card:active {
        transform: translateY(0) scale(0.995);
    }

    .card-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background-color: rgba(255, 255, 255, 0.14);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .card-text {
        display: flex;
        flex-direction: column;
    }

    .card-title {
        font-size: 1.05rem;
        font-weight: 600;
    }

    .card-subtitle {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-top: 0.1rem;
    }

    .arrow {
        font-size: 1.2rem;
        color: var(--text-secondary);
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .link-card:hover .arrow {
        transform: translate(3px, -3px);
        color: #ffffff;
    }

    /* Footer */
    footer {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-top: 0.25rem;
    }

    .copyright {
        text-align: center;
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.65);
    }
</style>
</body>
</html>